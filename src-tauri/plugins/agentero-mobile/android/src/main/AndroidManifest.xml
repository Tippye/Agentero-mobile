<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Vendor-documented sender permission for the OPPO/OnePlus pencil body shortcut
         broadcast. The app is installable without it; the adapter reports unavailable. -->
    <uses-permission android:name="com.oplus.ipemanager.permission.receiver.DOUBLE_CLICK" />
    <application>
        <service
            android:name="app.agentero.mobile.AndroidAgentConnectionService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintaining connectivity for remote Agent sessions explicitly enabled by the user" />
        </service>
        <service
            android:name="app.agentero.mobile.AndroidDataSyncService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name="app.agentero.mobile.AndroidBackgroundStopReceiver"
            android:exported="false" />
    </application>
</manifest>
